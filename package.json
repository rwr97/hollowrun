{
  "name": "hollowrun",
  "version": "2.0.4",
  "description": "A zero-credential, local Steam idling tool for Windows that connects directly to your active Steam desktop client instance using Steamworks IPC.",
  "author": "Julian",
  "repository": {
    "type": "git",
    "url": "https://github.com/lwkshy/hollowrun.git"
  },
  "bugs": {
    "url": "https://github.com/lwkshy/hollowrun/issues"
  },
  "homepage": "https://github.com/lwkshy/hollowrun#readme",
  "main": "electron-main.cjs",
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend",
    "start": "electron .",
    "version:sync": "node scripts/sync-version.cjs",
    "version:patch": "node scripts/bump-version.cjs patch",
    "version:minor": "node scripts/bump-version.cjs minor",
    "version:major": "node scripts/bump-version.cjs major",
    "prebuild": "npm run version:sync",
    "generate:brand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1",
    "prepare:portable": "node scripts/prepare-portable-template.cjs",
    "build:frontend": "npm run build --prefix frontend",
    "build:worker": "dotnet publish HollowRun.Worker/HollowRun.Worker.csproj -c Release -r win-x64 --self-contained false -o HollowRun.Worker/publish",
    "build:splash": "dotnet publish HollowRun.Splash/HollowRun.Splash.csproj -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -o HollowRun.Splash/publish",
    "package:app": "npm run build:worker && npm run build:splash && npm run generate:brand && npm run prepare:portable && npm run build:frontend",
    "build": "npm run package:app && electron-builder --win --publish never",
    "release:publish": "npm run version:sync && npm run package:app && electron-builder --win --publish onTag",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix backend && npm test --prefix frontend && node --test window-state.test.cjs startup-gate.test.cjs settings.test.cjs crash-reporting.test.cjs portable-relaunch.test.cjs local-service-client.test.cjs repository-config.test.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.hollowrun.app",
    "productName": "HollowRun",
    "publish": [
      {
        "provider": "github",
        "owner": "lwkshy",
        "repo": "hollowrun",
        "releaseType": "release"
      }
    ],
    "afterAllArtifactBuild": "./scripts/create-portable-update-manifest.cjs",
    "asar": true,
    "asarUnpack": [
      "HollowRun.Worker/publish/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "frontend/public/hollowrun.png"
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "HollowRun.Splash/publish/HollowRun.Splash.exe",
        "to": "HollowRun.PortableUpdater.exe"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.cjs",
      "crash-reporting-config.cjs",
      "crash-reporting.cjs",
      "json-storage.cjs",
      "local-service-client.cjs",
      "portable-relaunch.cjs",
      "portable-updater.cjs",
      "settings.cjs",
      "startup-gate.cjs",
      "loading.html",
      "loading-preload.cjs",
      "window-state.cjs",
      "backend/**/*",
      "!backend/**/*.test.js",
      "frontend/dist/**/*",
      "HollowRun.Worker/publish/**/*"
    ]
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@sentry/electron": "^7.17.0",
    "electron-updater": "^6.8.12"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "electron-winstaller@5.4.0": true
  }
}
